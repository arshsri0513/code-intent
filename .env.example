# Neo4j Graph Database Configuration (Optional: runs on embedded engine if omitted)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# LLM Reasoning Engine (Optional: supports OpenAI / Sarvam AI)
OPENAI_API_KEY=
SARVAM_API_KEY=

# Server Configuration
PORT=8000
ENVIRONMENT=development
